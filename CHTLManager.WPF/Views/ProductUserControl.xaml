<UserControl x:Class="CHTLManager.WPF.Views.ProductUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Danh sách sản phẩm ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" TextChanged="TxtSearch_TextChanged" Margin="0,0,8,0"
                         ToolTip="Tìm theo tên hoặc mã vạch"/>
                <Button Grid.Column="1" Content="Làm mới" Margin="0" Click="BtnRefresh_Click"/>
            </Grid>

            <DataGrid Grid.Row="1" x:Name="dgProducts" SelectionChanged="DgProducts_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã vạch" Binding="{Binding Barcode}" Width="140"/>
                    <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Nhóm hàng" Binding="{Binding Category}" Width="130"/>
                    <DataGridTextColumn Header="Giá bán" Binding="{Binding Price, StringFormat=N0}" Width="90"/>
                    <DataGridTextColumn Header="Tồn kho" Binding="{Binding Stock}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ===== Form thêm / sửa / xóa ===== -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" Padding="14" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="THÔNG TIN SẢN PHẨM" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Mã vạch *" Margin="0,0,0,3"/>
                <TextBox x:Name="txtBarcode" Margin="0,0,0,8"/>

                <TextBlock Text="Tên sản phẩm *" Margin="0,0,0,3"/>
                <TextBox x:Name="txtName" Margin="0,0,0,8"/>

                <TextBlock Text="Nhóm hàng" Margin="0,0,0,3"/>
                <TextBox x:Name="txtCategory" Margin="0,0,0,8"/>

                <TextBlock Text="Giá bán (đ) *" Margin="0,0,0,3"/>
                <TextBox x:Name="txtPrice" Margin="0,0,0,8" HorizontalContentAlignment="Right"/>

                <TextBlock Text="Tồn kho *" Margin="0,0,0,3"/>
                <TextBox x:Name="txtStock" Margin="0,0,0,12" HorizontalContentAlignment="Right"/>

                <WrapPanel Margin="0,0,0,12">
                    <Button Content="Thêm" Click="BtnAdd_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                    <Button Content="Sửa" Click="BtnUpdate_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                    <Button Content="Xóa" Click="BtnDelete_Click" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/>
                    <Button Content="Nhập mới" Click="BtnNew_Click" Margin="0,0,8,8"/>
                </WrapPanel>

                <Separator Margin="0,0,0,10"/>

                <TextBlock Text="Nhập kho nhanh (số lượng thêm)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtImportQty" Margin="0,0,8,0" HorizontalContentAlignment="Right"/>
                    <Button Grid.Column="1" Content="Nhập thêm" Click="BtnImport_Click" Style="{StaticResource AccentButton}" Margin="0"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
