<Window x:Class="CHTLManager.WPF.Views.SupplierPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trả tiền nhà cung cấp" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="txtHeader" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="Số tiền trả (đ) *" Margin="0,0,0,4"/>
        <TextBox x:Name="txtAmount" HorizontalContentAlignment="Right" Margin="0,0,0,12"/>
        <TextBlock Text="Ghi chú (tiền mặt, chuyển khoản...)" Margin="0,0,0,4"/>
        <TextBox x:Name="txtNote" MaxLength="200" Margin="0,0,0,8"/>
        <TextBlock x:Name="txtError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MinHeight="20" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Ghi trả tiền" IsDefault="True" Click="BtnSave_Click" Style="{StaticResource AccentButton}"/>
            <Button Content="Hủy" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
