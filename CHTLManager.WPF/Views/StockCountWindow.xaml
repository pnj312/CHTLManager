<Window x:Class="CHTLManager.WPF.Views.StockCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiểm kê sản phẩm" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="txtProduct" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

        <TextBlock Text="Phần mềm ghi" Margin="0,0,0,4"/>
        <TextBox x:Name="txtBook" IsEnabled="False" Margin="0,0,0,12"/>

        <TextBlock Text="Đếm được thực tế (trên kệ + trong kho)" Margin="0,0,0,4"/>
        <TextBox x:Name="txtCounted" TextChanged="TxtCounted_TextChanged" Margin="0,0,0,10"/>

        <TextBlock x:Name="txtConclusion" TextWrapping="Wrap" FontWeight="SemiBold" MinHeight="40" Margin="0,0,0,8"/>

        <TextBlock x:Name="txtError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   MinHeight="20" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Cập nhật tồn kho" IsDefault="True" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Hủy" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
