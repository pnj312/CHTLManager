<Window x:Class="CHTLManager.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CHTLManager.WPF.Views"
        Title="CHTL Manager - Quản lý cửa hàng tiện lợi" Height="720" Width="1200"
        MinHeight="600" MinWidth="1000" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="CHTL MANAGER" Foreground="White" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="16,10"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="txtUserInfo" Foreground="White" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Đăng xuất" Click="BtnLogout_Click" Margin="0" Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="tabMain" SelectionChanged="TabMain_SelectionChanged" FontSize="15" Padding="4">
            <TabItem x:Name="tabSales" Header="Bán hàng">
                <views:POSUserControl x:Name="posView"/>
            </TabItem>
            <TabItem x:Name="tabInventory" Header="Quản lý Kho">
                <views:ProductUserControl x:Name="productView"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
