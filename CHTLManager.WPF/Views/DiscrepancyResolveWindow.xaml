<Window x:Class="CHTLManager.WPF.Views.DiscrepancyResolveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xử lý chênh lệch kho" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="txtHeader" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Text="Cách xử lý *" Margin="0,0,0,4"/>
        <ComboBox x:Name="cboResolution" FontSize="14" Margin="0,0,0,12" SelectionChanged="CboResolution_SelectionChanged"/>

        <StackPanel x:Name="pnlCompensation" Visibility="Collapsed">
            <TextBlock Text="Người chịu trách nhiệm * (chọn hoặc gõ tên)" Margin="0,0,0,4"/>
            <ComboBox x:Name="cboResponsible" IsEditable="True" DisplayMemberPath="FullName" FontSize="14" Margin="0,0,0,12"/>
            <TextBlock Text="Số tiền phải bồi thường (đ) *" Margin="0,0,0,4"/>
            <TextBox x:Name="txtCompensation" HorizontalContentAlignment="Right" Margin="0,0,0,4"/>
            <TextBlock Text="Phần mềm chỉ theo dõi số phải thu, không tự trừ lương." Foreground="Gray" FontSize="12" Margin="0,0,0,12"/>
        </StackPanel>

        <StackPanel x:Name="pnlPurchase" Visibility="Collapsed">
            <TextBlock Text="Nhà cung cấp * (chọn hoặc gõ tên mới)" Margin="0,0,0,4"/>
            <ComboBox x:Name="cboSupplier" IsEditable="True" DisplayMemberPath="Name" FontSize="14" Margin="0,0,0,12"/>
            <TextBlock Text="Số hóa đơn của lô chưa ghi *" Margin="0,0,0,4"/>
            <TextBox x:Name="txtInvoice" MaxLength="50" Margin="0,0,0,12"/>
            <TextBlock Text="Giá nhập một đơn vị (đ) *" Margin="0,0,0,4"/>
            <TextBox x:Name="txtCost" HorizontalContentAlignment="Right" Margin="0,0,0,12"/>
        </StackPanel>

        <TextBlock x:Name="lblNote" Text="Ghi chú" Margin="0,0,0,4"/>
        <TextBox x:Name="txtNote" MaxLength="200" Margin="0,0,0,8"/>

        <TextBlock x:Name="txtError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MinHeight="20" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Lưu cách xử lý" IsDefault="True" Click="BtnSave_Click" Style="{StaticResource AccentButton}"/>
            <Button Content="Để sau" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
