<Window x:Class="CHTLManager.WPF.Views.CompensationPaymentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Các lần thu bồi thường" Width="720" Height="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="txtHeader" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <DataGrid Grid.Row="1" x:Name="dgPayments" SelectionChanged="DgPayments_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thời gian" Binding="{Binding PaidAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" Width="90"/>
                <DataGridTextColumn Header="Người ghi" Binding="{Binding User.FullName}" Width="120"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnCancelPayment" Content="Hủy lần thu đang chọn..." Click="BtnCancelPayment_Click" Style="{StaticResource DangerButton}"/>
            <Button x:Name="btnClose" Content="Đóng" IsCancel="True" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
