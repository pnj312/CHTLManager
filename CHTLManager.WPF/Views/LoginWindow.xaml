<Window x:Class="CHTLManager.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - CHTL Manager" Height="400" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="CỬA HÀNG TIỆN LỢI" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="1" Text="Đăng nhập hệ thống" FontSize="14" Foreground="Gray"
                   HorizontalAlignment="Center" Margin="0,2,0,22"/>

        <TextBlock Grid.Row="2" Text="Tên đăng nhập" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" x:Name="txtUsername" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="4" Text="Mật khẩu" Margin="0,0,0,4"/>
        <PasswordBox Grid.Row="5" x:Name="txtPassword" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="6">
            <TextBlock x:Name="txtError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       MinHeight="22" Margin="0,4,0,8"/>
            <Button x:Name="btnLogin" Content="Đăng nhập" IsDefault="True" Click="BtnLogin_Click"
                    Style="{StaticResource AccentButton}" Margin="0" Padding="0,10" FontSize="15"/>
        </StackPanel>
    </Grid>
</Window>
