<UserControl x:Class="CHTLManager.WPF.Views.PurchaseUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="dpFrom" Width="130" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="dpTo" Width="130" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="cboStatus" Width="130" Margin="0,0,10,0" SelectedIndex="0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="Tất cả"/>
                <ComboBoxItem Content="Chờ xác nhận"/>
                <ComboBoxItem Content="Đã xác nhận"/>
                <ComboBoxItem Content="Đã hủy"/>
            </ComboBox>
            <Button Content="Xem" Click="BtnView_Click" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="btnNew" Content="Nhập hàng mới..." Click="BtnNew_Click" Style="{StaticResource AccentButton}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgReceipts" SelectionChanged="DgReceipts_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Số phiếu" Binding="{Binding Code}" Width="140"/>
                <DataGridTextColumn Header="Ngày nhận" Binding="{Binding ReceivedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="135"/>
                <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding Supplier.Name}" Width="*"/>
                <DataGridTextColumn Header="Số hóa đơn" Binding="{Binding InvoiceNo}" Width="110"/>
                <DataGridTextColumn Header="Người nhập" Binding="{Binding CreatedBy.FullName}" Width="120"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusName}" Width="105"/>
                <DataGridTextColumn Header="Tiền hàng" Binding="{Binding TotalDisplay}" Width="105"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txtDetail" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource PrimaryBrush}" Text="CHI TIẾT PHIẾU"/>
            <Button Grid.Column="1" x:Name="btnConfirm" Content="Xác nhận phiếu..." Click="BtnConfirm_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Grid.Column="2" x:Name="btnCorrect" Content="Sửa giá nhập..." Click="BtnCorrect_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Grid.Column="3" x:Name="btnCancel" Content="Hủy phiếu..." Click="BtnCancel_Click" Style="{StaticResource DangerButton}" Margin="0"/>
        </Grid>

        <DataGrid Grid.Row="3" x:Name="dgLines">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sản phẩm" Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="SL hóa đơn" Binding="{Binding InvoicedQuantity}" Width="90"/>
                <DataGridTextColumn Header="Thực nhận" Binding="{Binding ReceivedQuantity}" Width="85"/>
                <DataGridTextColumn Header="Nhận thiếu" Binding="{Binding ShortQuantity}" Width="85"/>
                <DataGridTextColumn Header="Giá nhập" Binding="{Binding UnitCost, StringFormat=N0, TargetNullValue='Chưa có'}" Width="90"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineTotal, StringFormat=N0}" Width="105"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
