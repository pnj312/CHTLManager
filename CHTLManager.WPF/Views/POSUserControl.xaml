<UserControl x:Class="CHTLManager.WPF.Views.POSUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="980"
             Loaded="POSUserControl_Loaded"
             Language="vi-VN"
             Background="{StaticResource AppBackgroundBrush}"
             FontFamily="Segoe UI">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,16,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Margin="0,0,0,4"
                           FontSize="24"
                           Style="{StaticResource PageTitleStyle}"
                           Text="BÁN HÀNG" />
                <TextBlock Foreground="{StaticResource AppTextSecondaryBrush}"
                           FontSize="13"
                           Text="Tra cứu sản phẩm và chuẩn bị giỏ hàng" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Margin="0,0,0,6"
                           Foreground="{StaticResource AppTextPrimaryBrush}"
                           FontWeight="SemiBold"
                           Text="Mã vạch hoặc tên sản phẩm" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ProductLookupTextBox"
                             Width="300"
                             Style="{StaticResource AppTextBoxStyle}"
                             KeyDown="ProductLookupTextBox_KeyDown"
                             TextChanged="ProductLookupTextBox_TextChanged"
                             ToolTip="Nhập mã vạch hoặc tên sản phẩm" />
                    <Button x:Name="SearchProductButton"
                            MinWidth="80"
                            Margin="8,0,0,0"
                            Content="Tìm"
                            Click="SearchProductButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AppCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Danh sách sản phẩm" />

                    <DataGrid x:Name="AvailableProductsDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              MouseDoubleClick="AvailableProductsDataGrid_MouseDoubleClick"
                              Style="{StaticResource AppDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130" />
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="Giá bán" Binding="{Binding SellingPrice, StringFormat={}{0:N0} ₫}" Width="110" />
                            <DataGridTextColumn Header="Tồn kho" Binding="{Binding StockQuantity}" Width="90" />
                            <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource AppCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Giỏ hàng" />

                        <DataGrid x:Name="CartDataGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  Style="{StaticResource AppDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sản phẩm" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat={}{0:N0} ₫}" Width="100" />
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="90" />
                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineTotal, StringFormat={}{0:N0} ₫}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="IncreaseQuantityButton"
                                    Grid.Column="0"
                                    MinWidth="0"
                                    Content="+1"
                                    Click="IncreaseQuantityButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="DecreaseQuantityButton"
                                    Grid.Column="2"
                                    MinWidth="0"
                                    Content="-1"
                                    Click="DecreaseQuantityButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="RemoveCartItemButton"
                                    Grid.Column="4"
                                    MinWidth="0"
                                    Content="Bỏ sản phẩm"
                                    Click="RemoveCartItemButton_Click"
                                    Style="{StaticResource DangerButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="16"
                        Style="{StaticResource AppCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource AppTextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       Text="Tổng tiền" />
                            <TextBlock x:Name="TotalAmountTextBlock"
                                       Grid.Column="1"
                                       Foreground="{StaticResource AppPrimaryBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="0 ₫" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource AppTextPrimaryBrush}"
                                       Text="Khách đưa" />
                            <TextBox x:Name="CustomerPaymentTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource AppTextBoxStyle}"
                                     ToolTip="Nhập số tiền khách đưa" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource AppTextPrimaryBrush}"
                                       Text="Tiền thừa" />
                            <TextBlock x:Name="ChangeAmountTextBlock"
                                       Grid.Column="1"
                                       Foreground="{StaticResource AppTextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       Text="0 ₫" />
                        </Grid>

                        <TextBlock x:Name="POSMessageTextBlock"
                                   MinHeight="18"
                                   Foreground="{StaticResource AppDangerBrush}"
                                   FontSize="12"
                                   Text=""
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ClearCartButton"
                                    Grid.Column="0"
                                    Content="Hủy giỏ"
                                    Click="ClearCartButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="CheckoutButton"
                                    Grid.Column="2"
                                    Content="Thanh toán"
                                    Click="CheckoutButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
