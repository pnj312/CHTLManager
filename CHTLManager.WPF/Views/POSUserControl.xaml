<UserControl x:Class="CHTLManager.WPF.Views.POSUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="2.4*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Cột trái: quét mã vạch / chọn sản phẩm ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Quét mã vạch (nhấn Enter)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtBarcode" FontSize="18" KeyDown="TxtBarcode_KeyDown"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Tìm theo tên sản phẩm" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtSearch" TextChanged="TxtSearch_TextChanged"/>
            </StackPanel>

            <DataGrid Grid.Row="2" x:Name="dgProducts" MouseDoubleClick="DgProducts_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã vạch" Binding="{Binding Barcode}" Width="140"/>
                    <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Giá bán" Binding="{Binding Price, StringFormat=N0}" Width="90"/>
                    <DataGridTextColumn Header="Tồn" Binding="{Binding StockDisplay}" SortMemberPath="Stock" Width="Auto" MinWidth="60"
                                        ElementStyle="{StaticResource StockCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Thêm vào giỏ" Click="BtnAddSelected_Click" Style="{StaticResource PrimaryButton}"/>
                <TextBlock Text="(hoặc nhấp đúp vào sản phẩm)" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Nhận hàng..." Click="BtnReceive_Click" ToolTip="Nhà cung cấp giao hàng: ghi phiếu theo hóa đơn"/>
            </StackPanel>
        </Grid>

        <!-- ===== Cột phải: giỏ hàng & thanh toán ===== -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" Padding="12" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="GIỎ HÀNG" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1" x:Name="dgCart" IsReadOnly="False" CellEditEnding="DgCart_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sản phẩm" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat=N0}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="SL" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="45"/>
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineTotal, StringFormat=N0}" Width="90" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
                    <Button Content="+" Width="44" Padding="0,2" FontSize="18" FontWeight="Bold" Click="BtnPlus_Click"
                            ToolTip="Tăng số lượng dòng đang chọn"/>
                    <Button Content="−" Width="44" Padding="0,2" FontSize="18" FontWeight="Bold" Click="BtnMinus_Click"
                            ToolTip="Giảm số lượng dòng đang chọn"/>
                    <Button Content="Xóa dòng" Click="BtnRemove_Click" Style="{StaticResource DangerButton}"/>
                    <Button Content="Xóa giỏ" Click="BtnClear_Click"/>
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Tổng tiền:" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtTotal" Text="0 đ" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Text="Khách đưa:" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPaid" FontSize="18" HorizontalContentAlignment="Right"
                             TextChanged="TxtPaid_TextChanged" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Text="Tiền thừa:" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtChange" Text="0 đ" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,0,0,8"/>

                    <Button Grid.Row="3" Grid.ColumnSpan="2" Content="THANH TOÁN" FontSize="18" Padding="0,12" Margin="0"
                            Style="{StaticResource AccentButton}" Click="BtnPay_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
