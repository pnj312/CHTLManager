<Window x:Class="CHTLManager.WPF.Views.CompensationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa khoản bồi thường" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="txtHeader" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Text="Người chịu trách nhiệm * (chọn hoặc gõ tên)" Margin="0,0,0,4"/>
        <ComboBox x:Name="cboResponsible" IsEditable="True" DisplayMemberPath="FullName" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="Số tiền phải bồi thường (đ) *" Margin="0,0,0,4"/>
        <TextBox x:Name="txtAmount" HorizontalContentAlignment="Right" Margin="0,0,0,12"/>

        <TextBlock Text="Lý do sửa *" Margin="0,0,0,4"/>
        <TextBox x:Name="txtReason" MaxLength="150" Margin="0,0,0,8"/>

        <TextBlock x:Name="txtError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MinHeight="20" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Lưu thay đổi" IsDefault="True" Click="BtnSave_Click" Style="{StaticResource AccentButton}"/>
            <Button x:Name="btnClose" Content="Đóng" IsCancel="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
