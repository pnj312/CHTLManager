<UserControl x:Class="CHTLManager.WPF.Views.StockLogUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Từ ngày" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="dpFrom" Width="140" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="Đến ngày" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="dpTo" Width="140" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Xem" Click="BtnView_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Hôm nay" Click="BtnToday_Click"/>
            <Button Content="7 ngày" Click="BtnWeek_Click"/>
            <Button Content="Tháng này" Click="BtnMonth_Click"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,-10,10">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Thất thoát (theo giá bán)" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="txtLossValue" Text="0 đ" Style="{StaticResource CardValue}" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Số lượng thất thoát (mất, hỏng, hết hạn)" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="txtLossQuantity" Text="0" Style="{StaticResource CardValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Số lượng bán ngoài sổ" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="txtOutOfBook" Text="0" Style="{StaticResource CardValue}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <DataGrid Grid.Row="2" x:Name="dgLog">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
                <DataGridTextColumn Header="Người làm" Binding="{Binding User.FullName}" Width="130"/>
                <DataGridTextColumn Header="Sản phẩm" Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="Loại" Binding="{Binding TypeName}" Width="150"/>
                <DataGridTextColumn Header="Trước → Sau" Binding="{Binding StockChange}" Width="Auto" MinWidth="110"/>
                <DataGridTextColumn Header="Chênh lệch" Binding="{Binding DeltaText}" Width="85"/>
                <DataGridTextColumn Header="Lý do / Hóa đơn" Binding="{Binding Detail}" Width="230"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
